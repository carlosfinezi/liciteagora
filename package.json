{
  "name": "pncp-licitacoes",
  "version": "1.0.0",
  "description": "Sistema de consulta de licitações do Portal Nacional de Contratações Públicas (PNCP)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/pncp-licitacoes.exe",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "bin": "server.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/better-sqlite3/prebuilds/**/*",
      "node_modules/puppeteer/.local-chromium/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@2captcha/captcha-solver": "^1.3.2",
    "@peculiar/x509": "^1.14.2",
    "@signpdf/placeholder-plain": "^3.2.5",
    "@signpdf/signer-p12": "^3.2.4",
    "@signpdf/signpdf": "^3.2.5",
    "axios": "^1.13.5",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "node-forge": "^1.3.3",
    "node-signpdf": "^3.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-signer": "^1.1.4",
    "puppeteer": "^24.34.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  }
}
