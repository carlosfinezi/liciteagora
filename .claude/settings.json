{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run verify)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl is-active:*)",
      "Bash(journalctl:*)",
      "Bash(systemctl restart consulta-licitacoes.service)",
      "Bash(systemctl restart liciteagora.service)",
      "Bash(sudo systemctl restart consulta-licitacoes.service)",
      "Bash(sudo systemctl restart liciteagora.service)",
      "Bash(systemctl stop consulta-licitacoes.service)",
      "Bash(systemctl stop liciteagora.service)",
      "Bash(sudo systemctl stop consulta-licitacoes.service)",
      "Bash(sudo systemctl stop liciteagora.service)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(sudo rm:*)",
      "Bash(systemctl stop bll-session.service)",
      "Bash(sudo systemctl stop bll-session.service)",
      "Bash(systemctl stop bnc-session.service)",
      "Bash(sudo systemctl stop bnc-session.service)",
      "Bash(systemctl stop licitanet-collector.service)",
      "Bash(sudo systemctl stop licitanet-collector.service)",
      "Bash(systemctl stop govbr-bearer.service)",
      "Bash(sudo systemctl stop govbr-bearer.service)",
      "Bash(systemctl stop postgresql)",
      "Bash(systemctl stop postgresql:*)",
      "Bash(sudo systemctl stop postgresql)",
      "Bash(sudo systemctl stop postgresql:*)",
      "Bash(systemctl stop redis)",
      "Bash(systemctl stop redis:*)",
      "Bash(sudo systemctl stop redis)",
      "Bash(sudo systemctl stop redis:*)",
      "Bash(systemctl stop nginx)",
      "Bash(systemctl stop nginx:*)",
      "Bash(sudo systemctl stop nginx)",
      "Bash(sudo systemctl stop nginx:*)",
      "Bash(systemctl stop bind9)",
      "Bash(systemctl stop bind9:*)",
      "Bash(sudo systemctl stop bind9)",
      "Bash(sudo systemctl stop bind9:*)",
      "Bash(systemctl stop named)",
      "Bash(systemctl stop named:*)",
      "Bash(sudo systemctl stop named)",
      "Bash(sudo systemctl stop named:*)",
      "Bash(systemctl disable:*)",
      "Bash(sudo systemctl disable:*)",
      "Bash(systemctl mask:*)",
      "Bash(sudo systemctl mask:*)",
      "Bash(systemctl kill:*)",
      "Bash(sudo systemctl kill:*)",
      "Bash(pkill:*)",
      "Bash(killall:*)",
      "Bash(git stash:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Edit(./data/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)"
    ]
  }
}
