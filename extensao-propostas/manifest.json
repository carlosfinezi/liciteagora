{
  "manifest_version": 3,
  "name": "Propostas Comprasnet",
  "version": "2.0.0",
  "description": "Envia propostas via API REST para licitacoes do Comprasnet",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://cnetmobile.estaleiro.serpro.gov.br/*",
    "https://comprasnet.gov.br/*",
    "__SERVER_URL__/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://cnetmobile.estaleiro.serpro.gov.br/*",
        "https://comprasnet.gov.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
