{
  "name": "liciteagora-electron",
  "version": "5.2.15",
  "description": "Browser CEF para Comprasnet — login + sync + lances",
  "main": "electron-browser.js",
  "scripts": {
    "start": "electron --no-sandbox electron-browser.js",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64",
    "build:win:nsis": "electron-builder --win nsis --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.liciteagora.electron",
    "productName": "LiciteAgora Browser",
    "publish": [
      {
        "provider": "generic",
        "url": "https://1bit.liciteagora.app/api/electron/updates"
      }
    ],
    "files": [
      "electron-browser.js",
      "electron-nav.html",
      "token-manager.js",
      "store.js",
      "comprasnet-api.js",
      "server-sync.js",
      "lance-processor.js",
      "session-timers.js",
      "auto-updater.js",
      "updater-electron.js",
      "core/**/*",
      "portals/**/*",
      "INSTRUCOES.txt",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage"
    },
    "portable": {
      "artifactName": "LiciteAgora-Browser.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LiciteAgora Browser",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "LiciteAgora-Setup.exe",
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.0.2",
    "electron-builder": "^26.0.0"
  }
}